    "import sqlite3\n",
    "\n",
    "conn = sqlite3.connect(\"storage/news.db\")\n",
    "cursor = conn.cursor()\n",
    "\n",
    "cursor.execute(\"\"\"\n",
    "SELECT COUNT(*)\n",
    "FROM news\n",
    "WHERE DATE(published) = '2026-08-01'\n",
    "\"\"\")\n",
    "\n",
    "print(\"8月1日新闻数量：\", cursor.fetchone()[0])"
   ]
  }

# LLM API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Runtime paths used inside the containers
EMBEDDING_PROVIDER=online
NEWS_DB_PATH=/app/storage/news.db
SOURCES_PATH=/app/sources/rss_sources.yaml
VECTOR_DB_PATH=/app/storage/vector_store.db
BGE_MODEL_PATH=/app/models/bge-m3
BGE_MODEL_HOST_PATH=/absolute/path/to/bge-m3

# 按角色区分模型名称
LLM_EMBEDING= #文字向量化模型  v3 v4

# =========================
# 新闻结构化分析
# =========================
LLM_ANALYSE=
LLM_ANALYSE_FALLBACKS=

# =========================
# LangGraph / Agent
# =========================
LLM_MODEL=
LLM_MODEL_FALLBACKS=

# =========================
# 日报生成
# =========================
LLM_DAILY_REPORT=
LLM_DAILY_REPORT_FALLBACKS=

# URL reachable by the browser running the Next.js client
NEXT_PUBLIC_API_URL=
CORS_ORIGINS=

# Optional runtime configs
DEFAULT_MODEL=
LOG_LEVEL=INFO

NEXT_PUBLIC_API_URL=
IMAGE_PREFIX=

